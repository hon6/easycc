#!/bin/sh
# easyCC 虚拟机（macOS 12–25 用）：PID 1 启动脚本。挂文件系统、联网、共享目录，启动 Docker 和宿主机通信代理。
# 内核参数：easycc.share=<虚拟机状态目录在 Mac 上的路径>（通过 virtiofs 共享进来的 /Users 下）
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc 2>/dev/null; mount -t sysfs sysfs /sys 2>/dev/null
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm /run /sys/fs/cgroup
mount -t devpts devpts /dev/pts; mount -t tmpfs tmpfs /dev/shm; mount -t tmpfs tmpfs /run; mount -t tmpfs tmpfs /tmp
mount -t cgroup2 cgroup2 /sys/fs/cgroup
mount -o remount,rw /
LOG=/var/log/easycc-vm.log; mkdir -p /var/log; exec >>$LOG 2>&1
echo "==== $(date) 启动"
ulimit -n 65536
# 第一次开机：系统盘是在普通用户下做的，文件属主改回 root
if [ ! -f /etc/.easycc-owner-fixed ]; then chown -R 0:0 / -xdev 2>/dev/null; chmod 1777 /tmp; touch /etc/.easycc-owner-fixed; fi
hostname easycc-vm
for m in virtio_net vsock vmw_vsock_virtio_transport virtiofs fuse overlay bridge br_netfilter veth tun \
         nf_tables nft_compat nft_chain_nat nf_nat nf_conntrack ip_tables iptable_nat iptable_filter iptable_mangle ip6_tables ip6table_nat ip6table_filter \
         xt_owner xt_REDIRECT xt_MASQUERADE xt_conntrack xt_addrtype xt_comment xt_mark xt_multiport nf_reject_ipv4 ipt_REJECT virtio_balloon virtio_rng; do
  modprobe -q $m || echo "模块 $m 加载失败"
done
sysctl -qw net.ipv4.ip_forward=1 net.bridge.bridge-nf-call-iptables=1 2>/dev/null
ip link set lo up; ip link set eth0 up
udhcpc -i eth0 -q -t 20 -n -s /usr/share/udhcpc/default.script || echo "DHCP 失败"
# 数据盘（/dev/vdb）：Docker 镜像、容器都在这上面；系统盘升级时整个换掉，数据盘不动
mkdir -p /var/lib/docker
if [ -b /dev/vdb ]; then
  tune2fs -l /dev/vdb >/dev/null 2>&1 || { echo "初始化数据盘"; mkfs.ext4 -q -F -L easycc-data /dev/vdb; }
  mount -t ext4 /dev/vdb /var/lib/docker && { resize2fs /dev/vdb >/dev/null 2>&1 & }
fi
# Mac 的 /Users 共享进来（项目目录、环境数据都在这下面，Docker 挂载路径和 Mac 上一样）
mkdir -p /Users; mount -t virtiofs users /Users || echo "共享目录挂载失败"
# macOS 13+ Apple 芯片：Mac 共享了 Rosetta，注册成 x86_64 程序的解释器，amd64 容器（含 Kiteline）也能跑
mkdir -p /mnt/rosetta
if mount -t virtiofs rosetta /mnt/rosetta 2>/dev/null; then
  modprobe -q binfmt_misc; mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc 2>/dev/null
  echo ':rosetta:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00:\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:/mnt/rosetta/rosetta:CF' > /proc/sys/fs/binfmt_misc/register && echo "Rosetta 已注册"
fi
SHARE=$(sed -n 's/.*easycc.share=\([^ ]*\).*/\1/p' /proc/cmdline)
IP=$(ip -4 -o addr show eth0 | awk '{print $4}' | cut -d/ -f1); GW=$(ip route | awk '/default/{print $3; exit}')
echo "IP=$IP GW=$GW"
[ -n "$SHARE" ] && [ -d "$SHARE" ] && printf '{"ip":"%s","gateway":"%s","at":%s}\n' "$IP" "$GW" "$(date +%s)" > "$SHARE/guest.json"
# 日志放到 Mac 上的虚拟机状态目录（出问题时直接看，不用进虚拟机）
GL=/var/log; if [ -n "$SHARE" ] && [ -d "$SHARE" ]; then GL="$SHARE/guest-logs"; mkdir -p "$GL"; cat $LOG > "$GL/init.log"; exec >>"$GL/init.log" 2>&1; fi
mkdir -p /etc/docker
[ -f /etc/docker/daemon.json ] || echo '{"log-driver":"json-file","log-opts":{"max-size":"10m","max-file":"2"},"dns":["223.5.5.5","119.29.29.29","8.8.8.8"]}' > /etc/docker/daemon.json
( while :; do dockerd --host unix:///var/run/docker.sock >> "$GL/dockerd.log" 2>&1; echo "dockerd 退出，3 秒后重启"; sleep 3; done ) &
( while :; do python3 -I /usr/local/sbin/easycc-vsock-agent >> "$GL/vsock-agent.log" 2>&1; echo "vsock 代理退出，1 秒后重启"; sleep 1; done ) &
echo "已启动 dockerd、vsock 代理"
exec /sbin/tini -s -- sh -c 'while :; do sleep 3600; done'
