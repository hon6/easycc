# ---- 必填：上游代理（决定出口 IP）----
PROXY_URL=socks5://user:pass@1.2.3.4:1080

# ---- 可选 ----
INSTANCE=box
# 项目根目录（容器里是 /projects，管理后台能浏览、切换它下面的项目）
PROJECTS_ROOT=./projects
# 当前项目（相对根目录，留空 = 根目录本身；管理后台切换后会记在 data/conf/config.env 里）
PROJECT=
# 出口 IP 不等于它就断网（留空不检查）
EXPECT_IP=
# 留空 = 按出口 IP 自动匹配时区 / 浏览器语言
TZ_OVERRIDE=
ACCEPT_LANGUAGE=
# 留空 = 启动时随机生成（看 docker compose logs）
ADMIN_TOKEN=
VNC_PASSWORD=
# SSH 公钥（cat ~/.ssh/id_ed25519.pub 的内容），之后 ssh -p 2222 dev@127.0.0.1
SSH_AUTHORIZED_KEYS=
# 允许直连的网段（逗号分隔）；留空 = 全部封锁
ALLOW_DIRECT_CIDRS=
SCREEN=1600x1000
AUTOSTART_BROWSER=1

# 本机端口
ADMIN_PORT=7681
VNC_PORT=6080
SSH_PORT=2222
# 挂载目录的文件属主（Linux 上 id -u / id -g；Mac 一般 501 / 20）
HOST_UID=1000
HOST_GID=1000
